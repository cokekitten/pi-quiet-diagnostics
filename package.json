{
  "name": "pi-quiet-diagnostics",
  "version": "0.3.0",
  "description": "A pi extension that silences advisory startup diagnostics (skill collisions, extension package/command warnings) while keeping real errors visible.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "skills",
    "extensions",
    "diagnostics",
    "tui"
  ],
  "scripts": {
    "test": "node --test quiet-diagnostics.test.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/quiet-diagnostics.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "files": [
    "CHANGELOG.md",
    "extensions/",
    "README.md",
    "LICENSE"
  ]
}
